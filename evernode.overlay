/ {
    chosen {
        zephyr,code-partition = &slot0_partition;
    };

    aliases {
        i2c0 = &i2c5;
        i2c1 = &i2c3;
		/delete-property/ led0;
		/delete-property/ led1;
		/delete-property/ led2;
		/delete-property/ sw0;
		/delete-property/ sw1;
		/delete-property/ mcuboot-led0;
		/delete-property/ pwm-led0;
    };

    fstab {
        compatible = "zephyr,fstab";
        lfs1: lfs1 {
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/flash";
            automount;
            partition = <&storage_partition>;
            read-size = <1>;
            prog-size = <4>;
            cache-size = <8192>;
            lookahead-size = <32>;
            block-cycles = <512>;
        };
    };

    zephyr,user {
        io-channels = <&adc0 6>, <&adc0 7>;
    };
};

&pinctrl {
    i2c5_sleep: i2c5_sleep {
        group1 {
            pinmux = <M5SCL_P48>, <M5SDAWIR3_P49>;
        };
    };
    i2c3_sleep: i2c3_sleep {
        group1 {
            pinmux = <M3SCL_P42>, <M3SDAWIR3_P43>;
        };
    };
    adc0_default: adc0_default {
        group1 {
            pinmux = <ADCSE6_P34>, <ADCSE7_P35>, <ADCD0PSE8_P13>;
            drive-strength = "0.1";
        };
    };
};

&iom1 {
    spi1: spi {
        pinctrl-0 = <&spi1_default>;
        pinctrl-names = "default";
        clock-frequency = <DT_FREQ_M(10)>;
        status = "okay";
    };
};

&iom5 {
    i2c5: i2c {
        pinctrl-0 = <&i2c5_default>;
        pinctrl-1 = <&i2c5_sleep>;
        pinctrl-names = "default", "sleep";
        clock-frequency = <I2C_BITRATE_STANDARD>;
        scl-gpios = <&gpio32_63 16 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
        sda-gpios = <&gpio32_63 17 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
        status = "okay";
    };
};

&i2c3 {
    pinctrl-1 = <&i2c3_sleep>;
    pinctrl-names = "default", "sleep";
    status = "okay";
};

&flash0 {
    /delete-node/ partitions;
    partitions {
        ranges;
        #address-cells = <1>;
        #size-cells = <1>;

        internal_boot_partition: partition@0 {
            compatible = "zephyr,mapped-partition";
            label = "internal_bootloader";
            reg = <0x00000000 0xc000>;
        };

        slot0_partition: partition@c000 {
            compatible = "zephyr,mapped-partition";
            label = "image-0";
            reg = <0x0000c000 0xa0000>;
        };
        storage_partition: partition@ac000 {
            compatible = "zephyr,mapped-partition";
            label = "storage";
            reg = <0x000ac000 0x54000>;
        };
    };
};

/delete-node/ &{/leds};
/delete-node/ &{/buttons};
/delete-node/ &{/pwmleds};

&gpio0_31 {
  radio-nss {
    gpio-hog;
    gpios = <11 GPIO_ACTIVE_LOW>;
    output-high;
  };
  radio-nreset {
    gpio-hog;
    gpios = <17 GPIO_ACTIVE_LOW>;
    output-high;
  };
  rf-switch-power {
    gpio-hog;
    gpios = <18 GPIO_ACTIVE_HIGH>;
    output-low;
  };
};

&gpio32_63 {
  radio-npower {
    gpio-hog;
    gpios = <14 GPIO_ACTIVE_LOW>;
    output-low;
  };
  adc-enable {
    gpio-hog;
    gpios = <15 GPIO_ACTIVE_HIGH>;
    output-low;
  };
};

&adc0 {
	#address-cells = <1>;
	#size-cells = <0>;
    status = "okay";

    // ADCSE6: Vpanel
    channel@6 {
        reg = <6>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
    // ADCSE7: Vcap
    channel@7 {
        reg = <7>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
    //ADCD0PSE8_P13: Vbatt
    channel@8 {
        reg = <8>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
};

&uart0_default {
    group1 {
        pinmux = <UART0TX_P39>;
        bias-pull-up;
    };

    group2 {
        pinmux = <UART0RX_P40>;
        input-enable;
        bias-pull-up;
    };
};
