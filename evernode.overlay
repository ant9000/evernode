/ {
    chosen {
        zephyr,entropy = &rng_hci;
    };

    aliases {
        i2c0 = &i2c5;
		/delete-property/ led0;
		/delete-property/ led1;
		/delete-property/ led2;
		/delete-property/ sw0;
		/delete-property/ sw1;
		/delete-property/ mcuboot-led0;
		/delete-property/ pwm-led0;
    };

    fstab {
        compatible = "zephyr,fstab";
        lfs1: lfs1 {
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/flash";
            automount;
            partition = <&storage_partition>;
            read-size = <1>;
            prog-size = <4>;
            cache-size = <8192>;
            lookahead-size = <32>;
            block-cycles = <512>;
        };
    };

    zephyr,user {
        io-channels = <&adc0 6>, <&adc0 7>;
    };

    rng_hci: entropy_bt_hci {
        compatible = "zephyr,bt-hci-entropy";
        status = "okay";
    };
};

&pinctrl {
    i2c5_sleep: i2c5_sleep {
        group1 {
            pinmux = <M5SCL_P48>, <M5SDAWIR3_P49>;
        };
    };
    adc0_default: adc0_default {
        group1 {
            pinmux = <ADCSE6_P34>, <ADCSE7_P35>, <ADCD0PSE8_P13>;
            drive-strength = "0.1";
        };
    };
    mspi0_nor: mspi0_nor {
        group1 {
            pinmux = <MSPI0_0_P22>,
                 <MSPI0_1_P26>,
                 <MSPI0_2_P4>,
                 <MSPI0_3_P23>;
        };
        group2 {
            pinmux = <MSPI0_8_P24>;
            drive-strength = "1.0";
            ambiq,iom-mspi = <0>;
            ambiq,iom-num = <0>;
        };
        group3 {
            pinmux = <NCE19_P19>;
            drive-push-pull;
            drive-strength = "0.5";
            ambiq,iom-mspi = <0>;
            ambiq,nce-src = <0>;
            ambiq,iom-num = <0>;
        };
    };
};

&iom1 {
    spi1: spi {
        pinctrl-0 = <&spi1_default>;
        pinctrl-names = "default";
        clock-frequency = <DT_FREQ_M(10)>;
        status = "okay";
    };
};

&iom5 {
    i2c5: i2c {
        pinctrl-0 = <&i2c5_default>;
        pinctrl-1 = <&i2c5_sleep>;
        pinctrl-names = "default", "sleep";
        clock-frequency = <I2C_BITRATE_STANDARD>;
        scl-gpios = <&gpio32_63 16 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
        sda-gpios = <&gpio32_63 17 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
        status = "okay";
    };
};

/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &storage_partition;

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        slot0_partition: partition@18000 {
            label = "image-0";
            reg = <0x00018000 0x70000>;
        };
        storage_partition: partition@88000 {
            label = "storage";
            reg = <0x00088000 0x78000>;
        };
    };
};

/delete-node/ &{/leds};
/delete-node/ &{/buttons};
/delete-node/ &{/pwmleds};

&gpio32_63 {
  line-hogs {
    gpio-hog;
    gpios = <10 GPIO_ACTIVE_HIGH>, <15 GPIO_ACTIVE_HIGH>;
    output-low;
  };
};

&mspi0 {
    pinctrl-0 = <&mspi0_default>;
    pinctrl-1 = <&mspi0_sleep>;
    pinctrl-2 = <&mspi0_nor>;
    pinctrl-names = "default", "sleep", "nor";
    status = "okay";

    ce-gpios = <&gpio0_31 19 GPIO_ACTIVE_LOW>;

    cmdq-buffer-location = ".mspi_buff";
    cmdq-buffer-size = <256>;

    nor: nor@0 {
        compatible = "ambiq,mspi-device", "is25xX0xx";
        size = <DT_SIZE_M(8)>;
        reg = <0>;
        status = "okay";
        mspi-max-frequency = <8000000>;
        mspi-io-mode = "MSPI_IO_MODE_SINGLE";
        mspi-data-rate = "MSPI_DATA_RATE_SINGLE";
        mspi-dqs-enable;
        mspi-hardware-ce-num = <0>;
        read-command = <0xcc>;
        write-command = <0x8e>;
        command-length = "INSTR_1_BYTE";
        address-length = "ADDR_4_BYTE"; /* Avoid use of 3 byte address if Ambiq MSPI */
        rx-dummy = <16>;
        tx-dummy = <0>;
        ce-break-config = <0 0>;
        ambiq,timing-config-mask = <0x62>;
        ambiq,timing-config = <0 16 1 0 0 5 20>;

        partitions {
            compatible = "fixed-partitions";
            #address-cells = <1>;
            #size-cells = <1>;

            store_partition: partition@0 {
                label = "store";
                reg = <0x00000000 DT_SIZE_M(8)>;
            };
        };
    };
};


&adc0 {
	#address-cells = <1>;
	#size-cells = <0>;
    status = "okay";

    // ADCSE6: Vpanel
    channel@6 {
        reg = <6>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
    // ADCSE7: Vcap
    channel@7 {
        reg = <7>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
    //ADCD0PSE8_P13: Vbatt
    channel@8 {
        reg = <8>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
};

&uart0_default {
    group1 {
        pinmux = <UART0TX_P39>;
    };

    group2 {
        pinmux = <UART0RX_P40>;
        input-enable;
    };
};
